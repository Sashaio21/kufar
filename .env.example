# Токен бота, полученный у @BotFather
TELEGRAM_TOKEN=123456789:AAExampleTokenReplaceMe

# Твой chat_id, узнать у @userinfobot.
# ВАЖНО: только этот chat_id сможет управлять ботом (/status, /interval, /check).
TELEGRAM_CHAT_ID=123456789

# Периодичность автоматической проверки при первом запуске, в секундах.
# Дальше её можно менять из Telegram командой /interval - новое значение
# сохраняется в STATE_FILE и переживает перезапуск контейнера.
CHECK_INTERVAL_SECONDS=300

# Минимально допустимый интервал через /interval - защита от того, чтобы
# случайно не поставить слишком частый опрос и не словить бан на сайте.
MIN_INTERVAL_SECONDS=60

# Необязательно: порт HTTP-сервера внутри контейнера, отдаёт только /health
# (по умолчанию 8080)
# PORT=8080

# Необязательно: список профилей curl_cffi через запятую, пробуются по очереди
# IMPERSONATE_PROFILES=chrome124,chrome120,chrome110,safari17_0,edge101
